# KATANA — copy to .env and edit locally (never commit .env)

# --- Auth (see docs/AUTH.md) ---
KATANA_AUTH_MODE=local
KATANA_BOOTSTRAP_ADMIN_USER=admin
KATANA_BOOTSTRAP_ADMIN_PASSWORD=admin
# Optional legacy API token for scripts (admin role)
KATANA_TOKEN=change-me-dev-token
KATANA_SESSION_TTL=8h

KATANA_ADDR=0.0.0.0:8080
KATANA_DB_PATH=./data/katana.db
KATANA_LOG_LEVEL=info
KATANA_ADMISSION_DRY_RUN=true
# Admission evaluation budget (must stay below webhook timeoutSeconds).
# KATANA_ADMISSION_TIMEOUT=8s
# KATANA_ADMISSION_MAX_INFLIGHT=16
# Namespaces that evaluate as env=dev (default is prod for every other NS).
# KATANA_NONPROD_NAMESPACES=dev,qa,*-sandbox

# Policy storage: sqlite (default) | crd (Kubernetes ImagePolicy CRDs)
# KATANA_POLICY_SOURCE=sqlite
# KATANA_TLS_CERT=./deploy/certs/tls.crt
# KATANA_TLS_KEY=./deploy/certs/tls.key

# --- OIDC SSO (see docs/SSO.md) ---
# KATANA_OIDC_ENABLED=true
# KATANA_OIDC_ISSUER=https://idp.example.com
# KATANA_OIDC_CLIENT_ID=
# KATANA_OIDC_CLIENT_SECRET=
# KATANA_OIDC_REDIRECT_URI=https://katana.example.com/api/v1/auth/oidc/callback
# KATANA_OIDC_SCOPES=openid profile email
# KATANA_OIDC_GROUP_CLAIM=groups
# KATANA_OIDC_ADMIN_GROUPS=katana-admins
# KATANA_OIDC_READONLY_GROUPS=katana-readonly

# JFrog Xray (server-side only; required for live scan/evaluate)
# JFROG_URL=https://artifactory.example.com
# JFROG_TOKEN=
# JFROG_TIMEOUT=90s
# JFROG_PROXY=http://proxy.example.com:8080

# Fleet / Prometheus (optional multi-cluster UI)
# KATANA_CLUSTER_NAME=my-cluster
# PROMETHEUS_URL=http://127.0.0.1:9090
# FLEET_ADDR=0.0.0.0:8090
# FLEET_DB_PATH=./data/fleet.db
# FLEET_TOKEN=
